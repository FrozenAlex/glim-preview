diff --git a/shaders/preview_surface.slang b/shaders/preview_surface.slang
new file mode 100644
index 0000000..66fb3ea
--- /dev/null
+++ b/shaders/preview_surface.slang
@@ -0,0 +1,38 @@
+#include "includes/core.slang"
+
+struct SurfaceSample
+{
+    float4 lighting;
+    float4 albedo;
+    float4 normal;
+    float4 emission;
+};
+struct PushConstants { uint64_t outputAddress; uint width; uint height; }
+[[vk::push_constant]] PushConstants Push;
+
+[shader("compute")]
+[numthreads(8, 8, 1)]
+void main(uint3 threadID: SV_DispatchThreadID)
+{
+    uint2 coords = threadID.xy;
+    if (coords.x >= Push.width || coords.y >= Push.height) return;
+    float4 raw = LightmapDiffuse[coords];
+    float4 visibility = VisibilityBuffer[coords];
+    uint primitiveID = asuint(visibility.z);
+    SurfaceSample result;
+    result.lighting = 0;
+    result.albedo = 0;
+    result.normal = 0;
+    result.emission = raw; // Sky/background passes through without denoising.
+    if (primitiveID != uint::maxValue)
+    {
+        Surface surface = Surface::Get(asuint(visibility.z), visibility.xy);
+        result.albedo = float4(SampleAlbedo(surface.coords, surface.lightmapGroup).rgb, 1);
+        result.normal = float4(surface.N, 1);
+        result.emission = float4(SampleEmission(surface.coords, surface.lightmapGroup).rgb, raw.a);
+        // Primary albedo is multiplicative in the diffuse path tracer. Separate
+        // it and primary emission so neither is smoothed by the neural filter.
+        result.lighting.rgb = max(raw.rgb - result.emission.rgb, 0) / max(result.albedo.rgb, 1e-6);
+    }
+    ((SurfaceSample*)Push.outputAddress)[coords.y * Push.width + coords.x] = result;
+}
