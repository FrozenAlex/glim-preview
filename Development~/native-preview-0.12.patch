new file mode 100644
index 0000000..6f405b2
--- /dev/null
+++ b/src/preview_scene.rs
@@ -0,0 +1,319 @@
+//! Own a replacement export until the render thread can install it atomically.
+use std::sync::Mutex;
+use ash::vk::Handle;
+use crate::{*, mesh::{FfiMesh, Mesh, Vertex}, preview_geometry::MeshChunk};
+
+pub struct Scene {
+    system: CoordinateSystem,
+    base_revision: u64,
+    meshes: [Mesh; 4],
+    chunks: Vec<MeshChunk>,
+    mesh_order: Vec<MeshReference>,
+    groups: Vec<LightmapGroup>,
+    group_reuse: Vec<Option<usize>>,
+    lights: Vec<Light>,
+    cookies: Vec<TexturePixelsData>,
+    alphas: Vec<TexturePixelsData>,
+}
+
+enum MeshReference {
+    Uploaded(usize),
+    Reused { mesh: usize, group: u32, alpha: i32 },
+}
+
+impl Scene {
+    fn new(system: CoordinateSystem) -> Self {
+        Self { system, base_revision: 0, meshes: std::array::from_fn(|i| Mesh {
+            vertices: vec![], indices: vec![], main_uvs: vec![],
+            transparent: i % 2 != 0, no_shadows: i >= 2,
+        }), chunks: vec![], mesh_order: vec![], groups: vec![], group_reuse: vec![],
+            lights: vec![], cookies: vec![], alphas: vec![] }
+    }
+
+    fn valid(&self) -> bool {
+        self.groups.len() <= 256 && self.group_reuse.len() == self.groups.len() &&
+        self.groups.iter().zip(&self.group_reuse).all(|(g, reuse)| g.settings.width > 0 && g.settings.height > 0 &&
+            (reuse.is_some() || (g.albedo_pixels.len() == g.settings.width as usize * g.settings.height as usize * 4 &&
+            g.emission_pixels.len() == g.albedo_pixels.len()))) &&
+        self.meshes.iter().all(|m| m.vertices.iter().all(|v| v.group() < self.groups.len() as u32))
+    }
+
+    fn valid_reuse(&self, mailbox: &Mailbox) -> bool {
+        if self.base_revision != mailbox.applied { return false; }
+        let mut used = std::collections::HashSet::new();
+        self.groups.iter().zip(&self.group_reuse).all(|(group, old)| match old {
+            None => true,
+            Some(index) => used.insert(*index) && mailbox.group_sizes.get(*index) ==
+                Some(&(group.settings.width, group.settings.height)),
+        }) && self.mesh_order.iter().all(|entry| match entry {
+            MeshReference::Uploaded(index) => *index < self.chunks.len(),
+            MeshReference::Reused { mesh, group, alpha } => *mesh < mailbox.mesh_count &&
+                (*group as usize) < self.groups.len() && (*alpha == -1 ||
+                    (*alpha >= 0 && (*alpha as usize) < self.alphas.len() && *alpha < 0xffff)),
+        })
+    }
+}
+
+struct Mailbox { active: bool, next: u64, applied: u64, pending: Option<(u64, Box<Scene>)>,
+    mesh_count: usize, group_sizes: Vec<(u32, u32)> }
+static MAILBOX: Mutex<Mailbox> = Mutex::new(Mailbox { active: false, next: 2, applied: 0, pending: None,
+    mesh_count: 0, group_sizes: vec![] });
+
+pub fn reset(active: bool) {
+    *MAILBOX.lock().unwrap_or_else(|e| e.into_inner()) = Mailbox { active, next: 2, applied: 0, pending: None,
+        mesh_count: 0, group_sizes: vec![] };
+}
+fn mark_ready(app: &Glim, revision: u64) {
+    let mut mailbox = MAILBOX.lock().unwrap_or_else(|e| e.into_inner());
+    mailbox.mesh_count = app.preview_meshes.len();
+    mailbox.group_sizes = app.groups.iter().map(|g| (g.settings.width, g.settings.height)).collect();
+    mailbox.applied = revision;
+}
+pub fn mark_initial_ready(app: &Glim) { mark_ready(app, 1); }
+
+#[unsafe(no_mangle)]
+pub extern "C" fn app_preview_scene_revision() -> u64 {
+    MAILBOX.lock().unwrap_or_else(|e| e.into_inner()).applied
+}
+#[unsafe(no_mangle)]
+pub extern "C" fn app_new_preview_scene(system: CoordinateSystem) -> *mut Scene {
+    let mut scene = Scene::new(system);
+    scene.base_revision = app_preview_scene_revision();
+    Box::into_raw(Box::new(scene))
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn app_destroy_preview_scene(scene: *mut Scene) {
+    if !scene.is_null() { drop(unsafe { Box::from_raw(scene) }); }
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn preview_scene_add_mesh(scene: *mut Scene, mesh: FfiMesh) {
+    let scene = unsafe { &mut *scene };
+    let bucket = mesh.transparent as usize + 2 * mesh.no_shadows as usize;
+    let target = &mut scene.meshes[bucket];
+    let vertex_start = target.vertices.len();
+    let index_start = target.indices.len();
+    let emissive = mesh.emissive;
+    Mesh::append_ffi_mesh(target, mesh, scene.system, &scene.groups, false, emissive);
+    scene.chunks.push(MeshChunk { bucket, vertex_start, index_start,
+        index_count: target.indices.len() - index_start,
+        original_vertices: target.vertices[vertex_start..].to_vec(), flipped: false });
+    scene.mesh_order.push(MeshReference::Uploaded(scene.chunks.len() - 1));
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn preview_scene_reuse_mesh(scene: *mut Scene, mesh: u32, group: u32, alpha: i32) {
+    unsafe { &mut *scene }.mesh_order.push(MeshReference::Reused { mesh: mesh as usize, group, alpha });
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn preview_scene_add_light(scene: *mut Scene, mut light: Light) {
+    let scene = unsafe { &mut *scene };
+    light.convert_coordinate_system(scene.system);
+    light.shadow_radius_or_angle = light.shadow_radius_or_angle.max(0.0);
+    scene.lights.push(light);
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn preview_scene_add_group(scene: *mut Scene, settings: LightmapSettings,
+    albedo: *const u8, albedo_length: u32, emission: *const u8, emission_length: u32) {
+    let scene = unsafe { &mut *scene };
+    scene.groups.push(LightmapGroup::new(settings,
+        unsafe { std::slice::from_raw_parts(albedo, albedo_length as usize) },
+        unsafe { std::slice::from_raw_parts(emission, emission_length as usize) }));
+    scene.group_reuse.push(None);
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn preview_scene_reuse_group(scene: *mut Scene, old_group: u32, settings: LightmapSettings) {
+    let scene = unsafe { &mut *scene };
+    scene.groups.push(LightmapGroup::new(settings, &[], &[]));
+    scene.group_reuse.push(Some(old_group as usize));
+}
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn preview_scene_add_texture(scene: *mut Scene, alpha: bool,
+    pixels: *const u8, length: u32, width: u32, height: u32) {
+    let scene = unsafe { &mut *scene };
+    let data = TexturePixelsData { pixels: unsafe { std::slice::from_raw_parts(pixels, length as usize) }.to_vec(), width, height };
+    if alpha { scene.alphas.push(data); } else { scene.cookies.push(data); }
+}
+// Always consumes ownership, including rejection. The old GPU scene stays live
+// while Unity exports; only this bounded mailbox crosses into the render thread.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn app_commit_preview_scene(scene: *mut Scene) -> u64 {
+    if scene.is_null() { return 0; }
+    let scene = unsafe { Box::from_raw(scene) };
+    let mut mailbox = MAILBOX.lock().unwrap_or_else(|e| e.into_inner());
+    if !mailbox.active || mailbox.next != mailbox.applied + 1 || mailbox.pending.is_some() ||
+        !scene.valid() || !scene.valid_reuse(&mailbox) { return 0; }
+    let revision = mailbox.next;
+    mailbox.next += 1;
+    mailbox.pending = Some((revision, scene));
+    revision
+}
+
+pub fn ensure_nonempty(app: &mut Glim) {
+    if app.groups.is_empty() {
+        app.groups.push(LightmapGroup::new(LightmapSettings { width: 1, height: 1,
+            dilate: false, denoise: false, fix_seams: false, discard: false }, &[0;4], &[0;4]));
+    }
+    if app.meshes.iter().all(|m| m.indices.is_empty()) {
+        // A zero-area triangle is never hit, but keeps buffer/BVH APIs valid even
+        // after the last renderer is deleted. It has no exported object ID.
+        app.meshes[0].vertices = vec![Vertex { position: Vector3::ZERO, flags: 0, lightmap_group: 0, resolution: 0, pad: 0,
+            normal_octahedron: Vector2::ZERO, uv: Vector2::ZERO }; 3];
+        app.meshes[0].indices = vec![0,1,2];
+        app.meshes[0].main_uvs = vec![[0.;4];3];
+    }
+}
+
+fn release_scene(app: &mut Glim) {
+    // Pipelines hold descriptors into the old textures and acceleration structures.
+    app.tlas.destroy(&app.vk);
+    app.gpu_mesh.destroy(&app.vk);
+    app.gpu_mesh = GpuMesh::null();
+    for buffer in [&mut app.bvh_nodes, &mut app.bvh_triangles, &mut app.gpu_lights, &mut app.emissive_triangles_buffer] {
+        if !buffer.buffer.is_null() { buffer.destroy(&app.vk); }
+    }
+    // Atlas images survive until prepare_scene transfers the reused slots and
+    // releases the others. Cookies and alpha textures are freshly exported.
+    for array in [&mut app.cookie_array, &mut app.alphas_array] {
+        array.destroy(&app.vk);
+        *array = TextureArray::null();
+    }
+    app.seams.clear();
+    app.emissive_triangles.clear();
+}
+
+fn copy_chunk(source: &Mesh, chunk: &MeshChunk, destination: &mut Mesh,
+    remap: Option<(u32, i32)>) -> MeshChunk {
+    let vertex_start = destination.vertices.len();
+    let index_start = destination.indices.len();
+    let mut vertices = source.vertices[chunk.vertex_start..chunk.vertex_start + chunk.original_vertices.len()].to_vec();
+    let mut original_vertices = chunk.original_vertices.clone();
+    let mut uvs = source.main_uvs[chunk.index_start..chunk.index_start + chunk.index_count].to_vec();
+    if let Some((group, alpha)) = remap {
+        for vertex in vertices.iter_mut().chain(original_vertices.iter_mut()) {
+            vertex.lightmap_group = group as u8;
+        }
+        for uv in &mut uvs { uv[2] = f32::from_bits((uv[2].to_bits() & !0xffff) | (alpha as u32 & 0xffff)); }
+    }
+    destination.vertices.extend(vertices);
+    destination.indices.extend(source.indices[chunk.index_start..chunk.index_start + chunk.index_count]
+        .iter().map(|index| *index - chunk.vertex_start as u32 + vertex_start as u32));
+    destination.main_uvs.extend(uvs);
+    MeshChunk { bucket: chunk.bucket, vertex_start, index_start, index_count: chunk.index_count,
+        original_vertices, flipped: chunk.flipped }
+}
+
+fn resolve_meshes(scene: &Scene, app: &Glim) -> ([Mesh; 4], Vec<MeshChunk>) {
+    let mut meshes = Scene::new(scene.system).meshes;
+    let mut chunks = Vec::with_capacity(scene.mesh_order.len());
+    for entry in &scene.mesh_order {
+        let (source, chunk, remap) = match *entry {
+            MeshReference::Uploaded(index) => {
+                let chunk = &scene.chunks[index];
+                (&scene.meshes[chunk.bucket], chunk, None)
+            },
+            MeshReference::Reused { mesh, group, alpha } => {
+                let chunk = &app.preview_meshes[mesh];
+                (&app.meshes[chunk.bucket], chunk, Some((group, alpha)))
+            },
+        };
+        chunks.push(copy_chunk(source, chunk, &mut meshes[chunk.bucket], remap));
+    }
+    (meshes, chunks)
+}
+
+pub fn apply_updates(app: &mut Glim) {
+    let pending = MAILBOX.lock().unwrap_or_else(|e| e.into_inner()).pending.take();
+    let Some((revision, scene)) = pending else { return; };
+    unsafe { app.vk.device.device_wait_idle().unwrap(); }
+    let (meshes, chunks) = resolve_meshes(&scene, app);
+    let reused_meshes = scene.mesh_order.iter().filter(|e| matches!(e, MeshReference::Reused { .. })).count();
+    let reused_groups = scene.group_reuse.iter().filter(|g| g.is_some()).count();
+    #[cfg(test)]
+    let reused_images: Vec<_> = scene.group_reuse.iter().enumerate().filter_map(|(new, old)| old.map(|old|
+        (new, app.albedo_array.textures[old].image, app.emission_array.textures[old].image))).collect();
+    // Old mesh IDs, cookie indices and atlas IDs must not reach the new export.
+    preview_geometry::reset(true);
+    preview_updates::reset(true);
+    release_scene(app);
+    let Scene { groups, group_reuse, lights, cookies, alphas, .. } = *scene;
+    app.meshes = meshes;
+    app.preview_meshes = chunks;
+    app.groups = groups;
+    app.preview_reuse_groups = group_reuse;
+    app.cpu_lights = lights;
+    app.light_cookies = cookies;
+    app.alphas = alphas;
+    prepare_scene(app);
+    #[cfg(test)]
+    for (group, albedo, emission) in reused_images {
+        assert_eq!(app.albedo_array.textures[group].image, albedo, "Reused albedo was reallocated");
+        assert_eq!(app.emission_array.textures[group].image, emission, "Reused emission was reallocated");
+    }
+    preview_geometry::set_mesh_count(app.preview_meshes.len());
+    preview_geometry::refresh_shaders(app, true);
+    app.preview_push_constants.lights_address = app.gpu_lights.gpu_address;
+    app.preview_push_constants.lights_count = app.cpu_lights.len() as u32;
+    app.preview_initialized = false;
+    Log::msg(&format!("Preview refresh: reused {reused_groups} material atlases and {reused_meshes} meshes"));
+    mark_ready(app, revision);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn preview_scene_validates_atlas_sizes_and_allows_empty_scene() {
+        let mut scene = Scene::new(CoordinateSystem::Unity);
+        assert!(scene.valid());
+        scene.groups.push(LightmapGroup::new(LightmapSettings { width: 2, height: 2,
+            dilate: false, denoise: false, fix_seams: false, discard: false }, &[0;4], &[0;4]));
+        scene.group_reuse.push(None);
+        assert!(!scene.valid());
+    }
+
+    #[test]
+    fn preview_reuse_remaps_groups_alpha_and_indices_preserving_current_and_original_pose() {
+        let mut source = Scene::new(CoordinateSystem::Default).meshes[0].clone();
+        let original = Vertex { position: Vector3::new(1.,2.,3.), flags: Vertex::EMISSIVE_BIT, lightmap_group: 7, resolution: 2, pad: 0,
+            normal_octahedron: Vector2::ZERO, uv: Vector2::new(0.2,0.7) };
+        let mut current = original.clone(); current.position.x = 10.;
+        source.vertices = vec![original.clone(), current.clone(), current.clone(), current.clone()];
+        source.indices = vec![0,0,0,1,3,2];
+        source.main_uvs = vec![[0.1,0.9,f32::from_bits(3 | (1 << 16)),0.4];6];
+        let chunk = MeshChunk { bucket: 0, vertex_start: 1, index_start: 3, index_count: 3,
+            original_vertices: vec![original;3], flipped: true };
+        let mut destination = Scene::new(CoordinateSystem::Default).meshes[0].clone();
+        destination.vertices.push(current);
+        let copied = copy_chunk(&source, &chunk, &mut destination, Some((2,-1)));
+        assert_eq!(destination.indices, [1,3,2]);
+        assert_eq!(destination.vertices[1].position.x, 10.);
+        assert_eq!(copied.original_vertices[0].position.x, 1.);
+        assert_eq!(destination.vertices[1].flags, Vertex::EMISSIVE_BIT);
+        assert_eq!(copied.original_vertices[0].flags, Vertex::EMISSIVE_BIT);
+        assert_eq!((destination.vertices[1].uv.x, destination.vertices[1].uv.y), (0.2,0.7));
+        assert!(copied.flipped);
+        assert_eq!(destination.vertices[1].group(), 2);
+        assert_eq!(copied.original_vertices[0].group(), 2);
+        assert_eq!(destination.main_uvs[0][2].to_bits(), 0xffff | (1 << 16));
+        assert_eq!(destination.main_uvs[0][3], 0.4);
+    }
+
+    #[test]
+    fn preview_reuse_rejects_duplicate_atlases_stale_revision_and_bad_mesh_ids() {
+        let mut scene = Scene::new(CoordinateSystem::Default);
+        scene.base_revision = 3;
+        let mailbox = Mailbox { active: true, applied: 3, next: 4, pending: None,
+            mesh_count: 1, group_sizes: vec![(4,4)] };
+        let settings = LightmapSettings { width: 4, height: 4, dilate: false,
+            denoise: false, fix_seams: false, discard: false };
+        scene.groups.push(LightmapGroup::new(settings.clone(), &[], &[]));
+        scene.group_reuse.push(Some(0));
+        scene.mesh_order.push(MeshReference::Reused { mesh: 0, group: 0, alpha: -1 });
+        assert!(scene.valid() && scene.valid_reuse(&mailbox));
+        scene.base_revision = 2; assert!(!scene.valid_reuse(&mailbox));
+        scene.base_revision = 3;
+        scene.mesh_order.push(MeshReference::Reused { mesh: 1, group: 0, alpha: -1 });
+        assert!(!scene.valid_reuse(&mailbox)); scene.mesh_order.pop();
+        scene.groups.push(LightmapGroup::new(settings, &[], &[]));
+        scene.group_reuse.push(Some(0)); assert!(!scene.valid_reuse(&mailbox));
+    }
+}
