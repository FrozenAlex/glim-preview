+++ b/src/preview_bridge.rs
@@ -0,0 +1,255 @@
+//! Owned, bounded mailboxes between the Unity thread and the Vulkan thread.
+use std::{collections::BTreeMap, sync::Mutex};
+use crate::{camera::InitializePreviewPushConstants, math::Vector3};
+
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct PreviewView {
+    pub origin: Vector3,
+    pub origin_dx: Vector3,
+    pub origin_dy: Vector3,
+    pub direction: Vector3,
+    pub direction_dx: Vector3,
+    pub direction_dy: Vector3,
+    pub width: u32,
+    pub height: u32,
+    pub revision: u32,
+}
+
+impl PreviewView {
+    fn valid(&self) -> bool {
+        self.width > 0 && self.height > 0 && self.width <= 2048 && self.height <= 2048 &&
+        self.revision != 0 &&
+        [self.origin, self.origin_dx, self.origin_dy, self.direction, self.direction_dx, self.direction_dy]
+            .iter().all(|v| v.x.is_finite() && v.y.is_finite() && v.z.is_finite()) &&
+        self.direction.length_squared() > 0.000001
+    }
+
+    pub fn constants(&self) -> InitializePreviewPushConstants {
+        InitializePreviewPushConstants {
+            origin: self.origin, origin_pad: 0.0, origin_dx: self.origin_dx, origin_dx_pad: 0.0,
+            origin_dy: self.origin_dy, origin_dy_pad: 0.0,
+            direction: self.direction, direction_pad: 0.0, direction_dx: self.direction_dx, direction_dx_pad: 0.0,
+            direction_dy: self.direction_dy, direction_dy_pad: 0.0,
+        }
+    }
+}
+
+pub struct Frame {
+    pub revision: u32,
+    pub generation: u64,
+    pub samples: u32,
+    pub pixels: Vec<u8>,
+}
+
+#[derive(Default)]
+struct Bridge {
+    active: bool,
+    embedded: bool,
+    view: Option<PreviewView>,
+    emission_sizes: Vec<usize>,
+    emissions: BTreeMap<u32, Vec<u8>>,
+    frame: Option<Frame>,
+    generation: u64,
+    denoise: bool,
+    denoise_epoch: u64,
+    denoise_status: u32,
+    denoised: Option<Frame>,
+}
+
+static BRIDGE: Mutex<Bridge> = Mutex::new(Bridge {
+    active: false, embedded: false, view: None, emission_sizes: Vec::new(),
+    emissions: BTreeMap::new(), frame: None,
+    generation: 0, denoise: false, denoise_epoch: 0, denoise_status: 0, denoised: None,
+});
+
+pub fn reset(active: bool, embedded: bool) {
+    *BRIDGE.lock().unwrap_or_else(|e| e.into_inner()) = Bridge { active, embedded, ..Default::default() };
+}
+
+pub fn register_emissions(sizes: Vec<usize>) {
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    bridge.emission_sizes = sizes;
+    bridge.emissions.clear();
+    bridge.frame = None;
+}
+
+pub fn take_emissions() -> BTreeMap<u32, Vec<u8>> {
+    std::mem::take(&mut BRIDGE.lock().unwrap_or_else(|e| e.into_inner()).emissions)
+}
+
+pub fn take_view() -> Option<PreviewView> {
+    BRIDGE.lock().unwrap_or_else(|e| e.into_inner()).view.take()
+}
+
+pub fn publish_frame(frame: Frame) {
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    if bridge.active && bridge.embedded { bridge.frame = Some(frame); }
+}
+
+pub fn begin_generation(generation: u64) {
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    bridge.generation = generation;
+    bridge.frame = None;
+    bridge.denoised = None;
+    if bridge.denoise && bridge.denoise_status != 4 { bridge.denoise_status = 1; }
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn app_set_preview_denoise(enabled: bool) -> bool {
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    if !bridge.active || !bridge.embedded { return false; }
+    if bridge.denoise != enabled {
+        bridge.denoise = enabled;
+        bridge.denoise_epoch += 1;
+        bridge.denoised = None;
+        bridge.denoise_status = if enabled { 1 } else { 0 };
+    }
+    true
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn app_preview_denoise_status() -> u32 {
+    BRIDGE.lock().unwrap_or_else(|e| e.into_inner()).denoise_status
+}
+
+pub fn denoise_request() -> Option<u64> {
+    let bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    (bridge.active && bridge.denoise && bridge.denoise_status != 4).then_some(bridge.denoise_epoch)
+}
+
+pub fn denoise_status(epoch: u64, status: u32) {
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    if bridge.active && bridge.denoise && bridge.denoise_epoch == epoch { bridge.denoise_status = status; }
+}
+
+pub fn publish_denoised(epoch: u64, frame: Frame) {
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    if bridge.active && bridge.denoise && bridge.denoise_epoch == epoch && bridge.generation == frame.generation {
+        bridge.denoised = Some(frame);
+        bridge.denoise_status = 3;
+    }
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn app_copy_preview_frame_hdr(pixels: *mut u8, capacity: u32, revision: u32, generation: *mut u64) -> u32 {
+    if pixels.is_null() || generation.is_null() { return 0; }
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    let Some(frame) = bridge.frame.as_ref() else { return 0; };
+    if frame.revision != revision || frame.pixels.len() != capacity as usize { return 0; }
+    let frame = bridge.frame.take().unwrap();
+    unsafe {
+        std::ptr::copy_nonoverlapping(frame.pixels.as_ptr(), pixels, frame.pixels.len());
+        *generation = frame.generation;
+    }
+    frame.samples
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn app_copy_preview_denoised(pixels: *mut u8, capacity: u32, revision: u32, generation: u64) -> u32 {
+    if pixels.is_null() { return 0; }
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    if !bridge.denoise || bridge.generation != generation { return 0; }
+    let Some(frame) = bridge.denoised.as_ref() else { return 0; };
+    if frame.revision != revision || frame.generation != generation || frame.pixels.len() != capacity as usize { return 0; }
+    let frame = bridge.denoised.take().unwrap();
+    unsafe { std::ptr::copy_nonoverlapping(frame.pixels.as_ptr(), pixels, frame.pixels.len()); }
+    frame.samples
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn app_update_preview_view(view: PreviewView) -> bool {
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    if !bridge.active || !bridge.embedded || !view.valid() { return false; }
+    bridge.view = Some(view);
+    true
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn app_update_preview_emission(group: u32, pixels: *const u8, length: u32) -> bool {
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    if !bridge.active || pixels.is_null() || length == 0 ||
+        bridge.emission_sizes.get(group as usize).copied() != Some(length as usize) { return false; }
+    // One latest atlas per group, copied before the managed array can move.
+    bridge.emissions.insert(group, unsafe { std::slice::from_raw_parts(pixels, length as usize) }.to_vec());
+    true
+}
+
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn app_copy_preview_frame(pixels: *mut u8, capacity: u32, revision: u32) -> u32 {
+    if pixels.is_null() { return 0; }
+    let mut bridge = BRIDGE.lock().unwrap_or_else(|e| e.into_inner());
+    let Some(frame) = bridge.frame.as_ref() else { return 0; };
+    if frame.revision != revision || frame.pixels.len() != capacity as usize { return 0; }
+    let frame = bridge.frame.take().unwrap();
+    unsafe { std::ptr::copy_nonoverlapping(frame.pixels.as_ptr(), pixels, frame.pixels.len()); }
+    frame.samples
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn view_layout_and_validation() {
+        assert_eq!(size_of::<PreviewView>(), 84);
+        assert_eq!(size_of::<InitializePreviewPushConstants>(), 96);
+        assert_eq!(std::mem::offset_of!(InitializePreviewPushConstants, direction), 48);
+        assert_eq!(std::mem::offset_of!(InitializePreviewPushConstants, direction_dy), 80);
+        assert_eq!(std::mem::offset_of!(PreviewView, revision), 80);
+        let mut view = PreviewView { origin: Vector3::ZERO, origin_dx: Vector3::ZERO,
+            origin_dy: Vector3::ZERO, direction: Vector3::new(0.0, 0.0, -1.0),
+            direction_dx: Vector3::ZERO, direction_dy: Vector3::ZERO,
+            width: 640, height: 360, revision: 1 };
+        assert!(view.valid());
+        view.height = 0; assert!(!view.valid());
+        view.height = 360; view.origin.x = f32::NAN; assert!(!view.valid());
+    }
+
+    #[test]
+    fn bridge_coalesces_atlases_checks_sizes_and_rejects_stale_frames() {
+        reset(true, true);
+        register_emissions(vec![4, 8]);
+        let pixels = [1u8; 8];
+        unsafe {
+            assert!(!app_update_preview_emission(0, pixels.as_ptr(), 8));
+            assert!(!app_update_preview_emission(2, pixels.as_ptr(), 8));
+            assert!(app_update_preview_emission(0, pixels.as_ptr(), 4));
+            assert!(app_update_preview_emission(0, pixels.as_ptr(), 4));
+            assert!(app_update_preview_emission(1, pixels.as_ptr(), 8));
+        }
+        assert_eq!(take_emissions().len(), 2);
+        assert!(take_emissions().is_empty());
+        publish_frame(Frame { revision: 7, generation: 0, samples: 3, pixels: pixels.to_vec() });
+        let mut dst = [0u8; 8];
+        unsafe {
+            assert_eq!(app_copy_preview_frame(dst.as_mut_ptr(), 8, 6), 0);
+            assert_eq!(app_copy_preview_frame(dst.as_mut_ptr(), 4, 7), 0);
+            assert_eq!(app_copy_preview_frame(dst.as_mut_ptr(), 8, 7), 3);
+            assert_eq!(dst, pixels);
+            assert_eq!(app_copy_preview_frame(dst.as_mut_ptr(), 8, 7), 0);
+        }
+        // Delayed OIDN output may never cross light/camera changes or a toggle epoch.
+        assert!(app_set_preview_denoise(true));
+        let epoch = denoise_request().unwrap();
+        begin_generation(2);
+        let frame = |generation| Frame { revision: 7, generation, samples: 8, pixels: pixels.to_vec() };
+        publish_denoised(epoch, frame(1));
+        unsafe { assert_eq!(app_copy_preview_denoised(dst.as_mut_ptr(), 8, 7, 2), 0); }
+        publish_denoised(epoch, frame(2));
+        unsafe {
+            assert_eq!(app_copy_preview_denoised(dst.as_mut_ptr(), 8, 6, 2), 0);
+            assert_eq!(app_copy_preview_denoised(dst.as_mut_ptr(), 8, 7, 1), 0);
+            assert_eq!(app_copy_preview_denoised(dst.as_mut_ptr(), 4, 7, 2), 0);
+            assert_eq!(app_copy_preview_denoised(dst.as_mut_ptr(), 8, 7, 2), 8);
+        }
+        assert!(app_set_preview_denoise(false));
+        assert!(app_set_preview_denoise(true));
+        publish_denoised(epoch, frame(2));
+        unsafe { assert_eq!(app_copy_preview_denoised(dst.as_mut_ptr(), 8, 7, 2), 0); }
+        publish_denoised(denoise_request().unwrap(), frame(2));
+        begin_generation(3);
+        unsafe { assert_eq!(app_copy_preview_denoised(dst.as_mut_ptr(), 8, 7, 2), 0); }
+        reset(false, false);
+        unsafe { assert!(!app_update_preview_emission(0, pixels.as_ptr(), 4)); }
+    }
+}
diff --git a/src/preview_denoise.rs b/src/preview_denoise.rs
new file mode 100644
index 0000000..ce9054c
--- /dev/null
+++ b/src/preview_denoise.rs
@@ -0,0 +1,238 @@
+//! OIDN works on demodulated surface lighting; materials/emission stay untouched.
+use std::{sync::mpsc, thread, time::{Duration, Instant}};
+use ash::vk::{self, Handle};
+use crate::{*, preview_bridge::{self as bridge, Frame}};
+
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+pub struct SurfaceSample {
+    pub lighting: [f32; 4], pub albedo: [f32; 4], pub normal: [f32; 4], pub emission: [f32; 4],
+}
+
+#[repr(C)]
+pub struct SurfacePush { output_address: u64, width: u32, height: u32 }
+
+struct Job {
+    epoch: u64, generation: u64, revision: u32, samples: u32,
+    width: usize, height: usize, surface: Vec<SurfaceSample>,
+}
+struct Finished { epoch: u64, result: Result<Frame, String> }
+
+fn filter(oidn: &mut Oidn, job: Job) -> Result<Frame, String> {
+    let count = job.surface.len();
+    let mut planes = vec![0f32; count * 12];
+    let (lighting, aux) = planes.split_at_mut(count * 4);
+    let (albedo, normal) = aux.split_at_mut(count * 4);
+    for (i, s) in job.surface.iter().enumerate() {
+        lighting[i*4..i*4+4].copy_from_slice(&s.lighting);
+        // Color is already demodulated: its matching albedo is white. Feeding
+        // the original colored texture here would teach OIDN a false color edge.
+        albedo[i*4..i*4+4].fill(if s.normal[3] != 0. { 1. } else { 0. });
+        normal[i*4..i*4+4].copy_from_slice(&s.normal);
+    }
+    // Exact darkness needs no inference, and primary emission must stay exact.
+    if lighting.iter().any(|v| *v != 0.) {
+        oidn.denoise_surface(lighting, albedo, normal, job.width, job.height)?;
+    }
+    let mut pixels = Vec::with_capacity(count * 16);
+    for (i, surface) in job.surface.iter().enumerate() {
+        for channel in 0..4 {
+            let value = if channel == 3 || surface.normal[3] == 0. { surface.emission[channel] }
+                else { lighting[i*4+channel].max(0.) * surface.albedo[channel] + surface.emission[channel] };
+            if !value.is_finite() { return Err("OIDN returned non-finite surface lighting".into()); }
+            pixels.extend(value.to_ne_bytes());
+        }
+    }
+    Ok(Frame { revision: job.revision, generation: job.generation, samples: job.samples, pixels })
+}
+
+struct Worker {
+    sender: Option<mpsc::SyncSender<Job>>, receiver: mpsc::Receiver<Finished>,
+    thread: Option<thread::JoinHandle<()>>, busy: bool,
+}
+
+impl Worker {
+    fn new() -> Self {
+        let (sender, jobs) = mpsc::sync_channel::<Job>(1);
+        let (results, receiver) = mpsc::channel();
+        let thread = thread::spawn(move || {
+            // Device, filter and buffers live and are destroyed on this thread.
+            let mut oidn = Oidn::load_preview();
+            while let Ok(job) = jobs.recv() {
+                let epoch = job.epoch;
+                let result = match &mut oidn {
+                    Ok(oidn) => filter(oidn, job),
+                    Err(error) => Err(error.clone()),
+                };
+                if results.send(Finished { epoch, result }).is_err() { break; }
+            }
+        });
+        Self { sender: Some(sender), receiver, thread: Some(thread), busy: false }
+    }
+}
+
+impl Drop for Worker {
+    fn drop(&mut self) {
+        self.sender.take();
+        if let Some(thread) = self.thread.take() { let _ = thread.join(); }
+    }
+}
+
+pub struct Pipeline {
+    worker: Option<Worker>, buffer: Buffer,
+    submitted: Option<(u64, u64, u32)>, last_submit: Instant,
+}
+
+impl Pipeline {
+    pub fn new() -> Self {
+        Self { worker: None, buffer: Buffer::null(), submitted: None,
+            last_submit: Instant::now() - Duration::from_secs(1) }
+    }
+
+    pub fn update(&mut self, app: &mut Glim, generation: u64) {
+        if let Some(worker) = &mut self.worker {
+            if worker.busy && worker.thread.as_ref().is_some_and(|thread| thread.is_finished()) {
+                worker.busy = false;
+                if let Some(epoch) = bridge::denoise_request() { bridge::denoise_status(epoch, 4); }
+                Log::msg("Surface denoising worker stopped unexpectedly; showing raw HDR lighting.");
+            }
+            if let Ok(done) = worker.receiver.try_recv() {
+                worker.busy = false;
+                match done.result {
+                    Ok(frame) => bridge::publish_denoised(done.epoch, frame),
+                    Err(error) => {
+                        bridge::denoise_status(done.epoch, 4);
+                        Log::msg(&format!("Surface denoising unavailable: {error}. Check OpenImageDenoise_DIR; the raw HDR preview remains available."));
+                    }
+                }
+            }
+        }
+        let Some(epoch) = bridge::denoise_request() else {
+            if self.worker.as_ref().map(|w| !w.busy).unwrap_or(false) { self.worker = None; }
+            if !self.buffer.buffer.is_null() { self.buffer.destroy(&app.vk); }
+            self.submitted = None;
+            return;
+        };
+        let samples = app.preview_push_constants.sample_index;
+        if samples < app.preview_push_constants.max_samples.min(8) || samples == 0 { return; }
+        if self.worker.as_ref().map(|w| w.busy).unwrap_or(false) { return; }
+        let stamp = (epoch, generation, samples);
+        if self.submitted == Some(stamp) { return; }
+        if self.submitted.map(|s| s.0 == epoch && s.1 == generation).unwrap_or(false) &&
+            self.last_submit.elapsed() < Duration::from_millis(500) { return; }
+        let view = app.external_view.unwrap();
+        let surface = capture(app, &mut self.buffer);
+        let worker = self.worker.get_or_insert_with(Worker::new);
+        let job = Job { epoch, generation, revision: view.revision, samples,
+            width: view.width as usize, height: view.height as usize, surface };
+        if worker.sender.as_ref().unwrap().try_send(job).is_ok() {
+            worker.busy = true; self.submitted = Some(stamp); self.last_submit = Instant::now();
+            bridge::denoise_status(epoch, 2);
+        }
+    }
+
+    pub fn destroy(&mut self, app: &Glim) {
+        self.worker = None; // Join before the DLL/render session can be destroyed.
+        if !self.buffer.buffer.is_null() { self.buffer.destroy(&app.vk); }
+    }
+}
+
+fn capture(app: &mut Glim, buffer: &mut Buffer) -> Vec<SurfaceSample> {
+    let width = app.config.preview_settings.width;
+    let height = app.config.preview_settings.height;
+    let count = width as usize * height as usize;
+    let bytes = count as u64 * size_of::<SurfaceSample>() as u64;
+    if buffer.bytes != bytes || buffer.buffer.is_null() {
+        if !buffer.buffer.is_null() { buffer.destroy(&app.vk); }
+        *buffer = Buffer::empty(&app.vk, "Preview surface lighting and guides".into(), bytes,
+            vk::BufferUsageFlags::STORAGE_BUFFER | vk::BufferUsageFlags::SHADER_DEVICE_ADDRESS,
+            vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT);
+    }
+    let bindings = ShaderBindings {
+        tlas: app.tlas.acceleration_structure,
+        albedos: &app.albedo_array.views(), emissions: &app.emission_array.views(),
+        cookies: &app.cookie_array.views(), alphas: &app.alphas_array.views(),
+        skybox: app.skybox.view(), skybox_sampler: app.skybox.sampler(),
+        visibility: app.render_target.visibility.view(), preview_diffuse: app.render_target.diffuse.view(),
+        linear_sampler: app.linear_sampler,
+    };
+    if app.preview_surface_shader.pipeline.is_null() {
+        app.preview_surface_shader = load_compute_shader(&app.vk, ShaderName::PreviewSurface,
+            &app.constants, &bindings, size_of::<SurfacePush>());
+    }
+    update_compute_shader(&app.vk, &app.preview_surface_shader, &bindings);
+    let cmd = app.vk.begin_single_use_cmd();
+    let diffuse = &mut app.render_target.diffuse;
+    let barrier = diffuse.barrier(vk::ImageLayout::GENERAL,
+        vk::AccessFlags::MEMORY_WRITE | vk::AccessFlags::MEMORY_READ, vk::AccessFlags::SHADER_READ);
+    unsafe {
+        app.vk.device.cmd_pipeline_barrier(cmd, vk::PipelineStageFlags::ALL_COMMANDS,
+            vk::PipelineStageFlags::COMPUTE_SHADER, vk::DependencyFlags::empty(), &[], &[], &[barrier]);
+        let shader = &app.preview_surface_shader;
+        app.vk.device.cmd_bind_pipeline(cmd, vk::PipelineBindPoint::COMPUTE, shader.pipeline);
+        app.vk.device.cmd_bind_descriptor_sets(cmd, vk::PipelineBindPoint::COMPUTE, shader.pipeline_layout,
+            0, &[shader.descriptor_set], &[]);
+        let push = SurfacePush { output_address: buffer.gpu_address, width, height };
+        app.vk.device.cmd_push_constants(cmd, shader.pipeline_layout, vk::ShaderStageFlags::COMPUTE, 0, &as_bytes(&push));
+        app.vk.device.cmd_dispatch(cmd, width.div_ceil(8), height.div_ceil(8), 1);
+        let barrier = vk::MemoryBarrier::default().src_access_mask(vk::AccessFlags::SHADER_WRITE)
+            .dst_access_mask(vk::AccessFlags::HOST_READ);
+        app.vk.device.cmd_pipeline_barrier(cmd, vk::PipelineStageFlags::COMPUTE_SHADER,
+            vk::PipelineStageFlags::HOST, vk::DependencyFlags::empty(), &[barrier], &[], &[]);
+    }
+    app.vk.end_single_use_cmd(cmd);
+    unsafe { std::slice::from_raw_parts(buffer.ptr.cast::<SurfaceSample>(), count).to_vec() }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    #[ignore = "requires the installed Open Image Denoise runtime"]
+    fn oidn_surface_lighting_preserves_materials_emission_and_hdr() {
+        let mut oidn = Oidn::load_preview().expect("OIDN runtime");
+        eprintln!("Surface OIDN device: {:?}", oidn.device_type());
+        let (width, height) = (96, 96);
+        let mut state = 127u32;
+        let mut before = 0f64;
+        let surface: Vec<_> = (0..width*height).map(|i| {
+            let x = i % width;
+            let level = if x < width/2 { 2. } else { 8. };
+            state = state.wrapping_mul(1664525).wrapping_add(1013904223);
+            let noise = ((state >> 8) as f32 / 16777216. - 0.5) * level;
+            before += (noise as f64).powi(2);
+            let tint = if i % 2 == 0 { [0.2, 0.8, 0.4, 1.] } else { [0.8, 0.2, 0.4, 1.] };
+            SurfaceSample { lighting: [level+noise, level+noise, level+noise, 0.], albedo: tint,
+                normal: if x < width/2 { [0.,0.,1.,1.] } else { [0.,1.,0.,1.] },
+                emission: [if i % 19 == 0 { 17. } else { 0. }, 0., 0., 1.] }
+        }).collect();
+        let mut reference: Vec<f32> = surface.iter().flat_map(|s| s.lighting).collect();
+        let guides = vec![1f32; width*height*4];
+        let normals: Vec<f32> = surface.iter().flat_map(|s| s.normal).collect();
+        oidn.denoise_surface(&mut reference, &guides, &normals, width, height).unwrap();
+        let result = filter(&mut oidn, Job { epoch: 1, generation: 7, revision: 3, samples: 8,
+            width, height, surface: surface.clone() }).unwrap();
+        let values: Vec<f32> = result.pixels.chunks_exact(4).map(|b| f32::from_ne_bytes(b.try_into().unwrap())).collect();
+        let mut after = 0f64;
+        for (i, pixel) in values.chunks_exact(4).enumerate() {
+            let level = if i % width < width/2 { 2. } else { 8. };
+            let s = surface[i];
+            // Check recomposition against the actual neural filter, including
+            // sharp checker albedo and isolated HDR emission pixels.
+            for c in 0..3 {
+                let expected = reference[i*4+c].max(0.)*s.albedo[c]+s.emission[c];
+                assert!((pixel[c]-expected).abs() < 0.0001, "Material or emission was filtered");
+                after += (((pixel[c]-s.emission[c])/s.albedo[c]-level) as f64).powi(2)/3.;
+            }
+            assert_eq!(pixel[3], 1.);
+            if s.emission[0] > 0. { assert!(pixel[0] >= 17.); }
+
+        }
+        eprintln!("HDR lighting squared error: {before:.4} -> {after:.4}");
+        assert!(after < before*0.4, "OIDN did not reduce surface lighting noise");
+        let surface = vec![SurfaceSample { emission: [12.,3.,2.,1.], ..Default::default() }; 16];
+        let sky = filter(&mut oidn, Job { epoch: 1, generation: 8, revision: 4, samples: 8,
+            width: 4, height: 4, surface }).unwrap();
+        assert!(sky.pixels.chunks_exact(16).all(|p| p == [12f32,3.,2.,1.].map(f32::to_ne_bytes).concat()));
+    }
+}
diff --git a/src/preview_embedded.rs b/src/preview_embedded.rs
new file mode 100644
index 0000000..646afe0
--- /dev/null
+++ b/src/preview_embedded.rs
@@ -0,0 +1,360 @@
+use std::time::{Duration, Instant};
+use ash::vk;
+use ash::vk::Handle;
+use crate::{*, preview_bridge::Frame};
+
+fn bind_preview(app: &mut Glim) {
+    let bindings = ShaderBindings {
+        tlas: app.tlas.acceleration_structure,
+        albedos: &app.albedo_array.views(), emissions: &app.emission_array.views(),
+        skybox: app.skybox.view(), skybox_sampler: app.skybox.sampler(),
+        visibility: app.render_target.visibility.view(),
+        preview_diffuse: app.render_target.diffuse.view(),
+        cookies: &app.cookie_array.views(), alphas: &app.alphas_array.views(),
+        linear_sampler: app.linear_sampler,
+    };
+    if app.preview_shader.pipeline.is_null() {
+        app.preview_shader = load_compute_shader(&app.vk, ShaderName::Preview,
+            &app.constants, &bindings, size_of::<PreviewPushConstants>());
+    }
+    update_compute_shader(&app.vk, &app.preview_shader, &bindings);
+}
+
+// Headless Vulkan uses the same path tracing shader as the separate window.
+// A bounded CPU readback also works when Unity runs D3D11 instead of Vulkan.
+pub fn render(app: &mut Glim) {
+    let mut readback = Buffer::null();
+    let mut denoise = preview_denoise::Pipeline::new();
+    let mut generation = 0u64;
+    let mut last_frame = Instant::now() - Duration::from_secs(1);
+    while !bindings::is_cancelled() {
+        let started = Instant::now();
+        if let Some(view) = preview_bridge::take_view() {
+            let resize = app.external_view.map(|v| v.width != view.width || v.height != view.height).unwrap_or(true);
+            app.external_view = Some(view);
+            if resize {
+                unsafe { app.vk.device.device_wait_idle().unwrap(); }
+                app.config.preview_settings.width = view.width;
+                app.config.preview_settings.height = view.height;
+                let settings = app.config.preview_settings.clone();
+                update_render_target(app, &settings);
+                bind_preview(app);
+                if !readback.buffer.is_null() { readback.destroy(&app.vk); }
+                readback = Buffer::empty(&app.vk, "Scene view readback".into(),
+                    view.width as u64 * view.height as u64 * 16,
+                    vk::BufferUsageFlags::TRANSFER_DST,
+                    vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT);
+            }
+            app.preview_initialized = false;
+        }
+        apply_preview_updates(app);
+        let Some(view) = app.external_view else {
+            std::thread::sleep(Duration::from_millis(10));
+            continue;
+        };
+        if !app.preview_initialized {
+            app.preview_push_constants.sample_index = 0;
+            generation += 1;
+            preview_bridge::begin_generation(generation);
+        }
+        if app.preview_push_constants.sample_index >= app.preview_push_constants.max_samples {
+            denoise.update(app, generation);
+            std::thread::sleep(Duration::from_millis(10));
+            continue;
+        }
+        let cmd = app.vk.begin_single_use_cmd();
+        record_preview_sample(app, cmd);
+        let samples = app.preview_push_constants.sample_index;
+        let copy = samples == 1 || samples == app.preview_push_constants.max_samples ||
+            last_frame.elapsed() >= Duration::from_millis(66);
+        if copy {
+            let diffuse = &mut app.render_target.diffuse;
+            let barrier = diffuse.barrier(vk::ImageLayout::TRANSFER_SRC_OPTIMAL,
+                vk::AccessFlags::SHADER_WRITE, vk::AccessFlags::TRANSFER_READ);
+            unsafe {
+                app.vk.device.cmd_pipeline_barrier(cmd, vk::PipelineStageFlags::COMPUTE_SHADER,
+                    vk::PipelineStageFlags::TRANSFER, vk::DependencyFlags::empty(), &[], &[], &[barrier]);
+                let region = vk::BufferImageCopy::default()
+                    .image_subresource(vk::ImageSubresourceLayers::default()
+                        .aspect_mask(vk::ImageAspectFlags::COLOR).layer_count(1))
+                    .image_extent(vk::Extent3D { width: view.width, height: view.height, depth: 1 });
+                app.vk.device.cmd_copy_image_to_buffer(cmd, diffuse.image(),
+                    vk::ImageLayout::TRANSFER_SRC_OPTIMAL, readback.buffer, &[region]);
+                let barrier = vk::MemoryBarrier::default().src_access_mask(vk::AccessFlags::TRANSFER_WRITE)
+                    .dst_access_mask(vk::AccessFlags::HOST_READ);
+                app.vk.device.cmd_pipeline_barrier(cmd, vk::PipelineStageFlags::TRANSFER,
+                    vk::PipelineStageFlags::HOST, vk::DependencyFlags::empty(), &[barrier], &[], &[]);
+            }
+        }
+        // This waits for completion before the mapped memory is read or resources change.
+        app.vk.end_single_use_cmd(cmd);
+        if copy {
+            let pixels = unsafe { std::slice::from_raw_parts(readback.ptr.cast::<u8>(), readback.bytes as usize) }.to_vec();
+            preview_bridge::publish_frame(Frame { revision: view.revision, generation, samples, pixels });
+            last_frame = Instant::now();
+        }
+        denoise.update(app, generation);
