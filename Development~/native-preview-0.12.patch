index 0000000..d6648dc
--- /dev/null
+++ b/src/preview_updates.rs
@@ -0,0 +1,299 @@
+use std::sync::Mutex;
+use crate::{bindings::CoordinateSystem, lights::Light, math::{Vector2, Vector3}};
+
+// Plain C layout shared with Bindings.PreviewLightState. Vectors are in the
+// exporting application's coordinate system, just like app_add_light inputs.
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct PreviewLightState {
+    pub color: Vector3,
+    pub position: Vector3,
+    pub direction: Vector3,
+    pub up: Vector3,
+    pub range: f32,
+    pub spot_inner_percent: f32,
+    pub spot_outer: f32,
+    pub area_size: Vector2,
+    pub ty: u32,
+    pub cast_shadows: u32,
+    pub mixed: u32,
+    pub cookie: u32,
+    pub shadow_radius_or_angle: f32,
+}
+
+impl PreviewLightState {
+    fn is_valid(&self) -> bool {
+        [self.color, self.position, self.direction, self.up].iter().all(|v|
+            v.x.is_finite() && v.y.is_finite() && v.z.is_finite()) &&
+            self.range.is_finite() && self.range >= 0.0 &&
+            self.spot_inner_percent.is_finite() && (0.0..=100.0).contains(&self.spot_inner_percent) &&
+            self.spot_outer.is_finite() && (0.0..=180.0).contains(&self.spot_outer) &&
+            self.area_size.x.is_finite() && self.area_size.x >= 0.0 &&
+            self.area_size.y.is_finite() && self.area_size.y >= 0.0 &&
+            self.ty <= 4 && self.cast_shadows <= 1 && self.mixed <= 1 &&
+            self.shadow_radius_or_angle.is_finite() && self.shadow_radius_or_angle >= 0.0
+    }
+}
+
+// Unity publishes snapshots; only the renderer thread touches Glim or Vulkan.
+#[derive(Default)]
+struct Updates {
+    active: bool,
+    pending: Option<Vec<PreviewLightState>>,
+    pending_indirect: Option<f32>,
+}
+
+impl Updates {
+    fn reset(&mut self, active: bool) {
+        self.active = active;
+        self.pending = None;
+        self.pending_indirect = None;
+    }
+
+    fn publish_indirect(&mut self, multiplier: f32) -> bool {
+        if !self.active || !multiplier.is_finite() || multiplier < 0.0 {
+            return false;
+        }
+        self.pending_indirect = Some(multiplier);
+        true
+    }
+
+    fn publish(&mut self, states: &[PreviewLightState]) -> bool {
+        if !self.active || states.iter().any(|s| !s.is_valid()) {
+            return false;
+        }
+        self.pending = Some(states.to_vec());
+        true
+    }
+}
+
+static UPDATES: Mutex<Updates> = Mutex::new(Updates { active: false, pending: None, pending_indirect: None });
+
+pub fn reset(active: bool) {
+    UPDATES.lock().unwrap_or_else(|e| e.into_inner()).reset(active);
+}
+
+pub fn take() -> Option<Vec<PreviewLightState>> {
+    UPDATES.lock().unwrap_or_else(|e| e.into_inner()).pending.take()
+}
+
+pub fn take_indirect() -> Option<f32> {
+    UPDATES.lock().unwrap_or_else(|e| e.into_inner()).pending_indirect.take()
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn app_update_preview_indirect_multiplier(multiplier: f32) -> bool {
+    UPDATES.lock().unwrap_or_else(|e| e.into_inner()).publish_indirect(multiplier)
+}
+
+// A snapshot replaces the entire list, so changing order, deleting the last
+// light, and Undo/Redo cannot leave stale light slots or inherit another cookie.
+pub fn apply(lights: &mut Vec<Light>, states: &[PreviewLightState], system: CoordinateSystem, cookie_count: usize) -> bool {
+    if states.iter().any(|s| !s.is_valid() || (s.cookie != u32::MAX && s.cookie as usize >= cookie_count)) {
+        return false;
+    }
+    lights.clear();
+    for state in states {
+        let mut light = Light {
+            color: state.color,
+            position: state.position,
+            direction: state.direction,
+            up: state.up,
+            range: state.range,
+            spot_inner_percent: state.spot_inner_percent,
+            spot_outer: state.spot_outer,
+            area_or_cookie_size: state.area_size,
+            ty: match state.ty {
+                0 => crate::lights::LightType::Directional,
+                1 => crate::lights::LightType::Point,
+                2 => crate::lights::LightType::Spot,
+                3 => crate::lights::LightType::Area,
+                4 => crate::lights::LightType::Disc,
+                _ => unreachable!(),
+            },
+            cast_shadows: state.cast_shadows != 0,
+            mixed: state.mixed != 0,
+            cookie: state.cookie,
+            shadow_radius_or_angle: state.shadow_radius_or_angle.max(0.0),
+            ..Default::default()
+        };
+        light.convert_coordinate_system(system);
+        lights.push(light);
+    }
+    true
+}
+
+/// The input is copied before returning. No app pointer crosses threads.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn app_update_preview_lights(states: *const PreviewLightState, count: u32) -> bool {
+    if states.is_null() && count != 0 {
+        return false;
+    }
+    let states = if count == 0 { &[] } else {
+        unsafe { std::slice::from_raw_parts(states, count as usize) }
+    };
+    UPDATES.lock().unwrap_or_else(|e| e.into_inner()).publish(states)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::lights::LightType;
+
+    fn state() -> PreviewLightState {
+        PreviewLightState {
+            color: Vector3::ONE, position: Vector3::new(1.0, 2.0, 3.0),
+            direction: Vector3::new(0.0, 1.0, 0.0), up: Vector3::new(0.0, 0.0, 1.0),
+            range: 9.0, spot_inner_percent: 80.0, spot_outer: 40.0,
+            area_size: Vector2::new(2.0, 3.0), ty: 2, cast_shadows: 1,
+            mixed: 0, cookie: u32::MAX, shadow_radius_or_angle: 0.0,
+        }
+    }
+
+    #[test]
+    fn add_delete_last_and_restore_from_empty() {
+        let mut lights = Vec::new();
+        assert!(apply(&mut lights, &[], CoordinateSystem::Unity, 0));
+        assert!(apply(&mut lights, &[state()], CoordinateSystem::Unity, 0));
+        assert_eq!(lights.len(), 1);
+        let mut area = state();
+        area.ty = 3;
+        area.position.x = 20.0;
+        assert!(apply(&mut lights, &[state(), area], CoordinateSystem::Unity, 0));
+        assert_eq!(lights.len(), 2);
+        assert_eq!(lights[1].ty, LightType::Area);
+        assert!(apply(&mut lights, &[area], CoordinateSystem::Unity, 0));
+        assert_eq!(lights.len(), 1);
+        assert_eq!(lights[0].position.x, 20.0);
+        assert!(apply(&mut lights, &[], CoordinateSystem::Unity, 0));
+        assert!(lights.is_empty());
+        assert!(apply(&mut lights, &[state(), area], CoordinateSystem::Unity, 0));
+        assert_eq!(lights.len(), 2);
+    }
+
+    #[test]
+    fn complete_snapshots_preserve_settings_across_reordering() {
+        let mut lights = Vec::new();
+        let mut spot = state();
+        spot.cookie = 0;
+        spot.mixed = 1;
+        let mut disc = state();
+        disc.ty = 4;
+        disc.cookie = 1;
+        disc.cast_shadows = 0;
+        disc.area_size = Vector2::new(4.0, 4.0);
+        for states in [[spot, disc], [disc, spot]] {
+            assert!(apply(&mut lights, &states, CoordinateSystem::Unity, 2));
+            for (light, expected) in lights.iter().zip(states) {
+                assert_eq!(light.cookie, expected.cookie);
+                assert_eq!(light.cast_shadows, expected.cast_shadows != 0);
+                assert_eq!(light.mixed, expected.mixed != 0);
+                assert_eq!(light.spot_outer, expected.spot_outer);
+                assert_eq!(light.area_or_cookie_size.x, expected.area_size.x);
+            }
+        }
+    }
+
+    #[test]
+    fn mailbox_coalesces_add_delete_and_clears_on_close() {
+        let mut updates = Updates::default();
+        assert!(!updates.publish(&[]));
+        updates.reset(true);
+        let mut snapshot = state();
+        assert!(updates.publish(&[snapshot]));
+        snapshot.position.x = 100.0;
+        assert_ne!(updates.pending.as_ref().unwrap()[0].position.x, snapshot.position.x);
+        assert!(updates.publish(&[]));
+        assert!(updates.pending.as_ref().unwrap().is_empty());
+        updates.reset(false);
+        assert!(updates.pending.is_none());
+        updates.reset(true);
+        assert!(updates.pending.is_none());
+    }
+
+    #[test]
+    fn repeated_snapshots_do_not_accumulate_coordinate_conversion() {
+        let mut lights = Vec::new();
+        for _ in 0..2 {
+            apply(&mut lights, &[state()], CoordinateSystem::Unity, 0);
+            assert_eq!(lights[0].position.z, -3.0);
+            assert_eq!(lights[0].direction.y, -1.0);
+            assert_eq!(lights[0].up.z, -1.0);
+            assert_eq!(lights[0].range, 9.0);
+            assert_eq!(lights[0].shadow_radius_or_angle, 0.0);
+        }
+        apply(&mut lights, &[state()], CoordinateSystem::Default, 0);
+        assert_eq!(lights[0].position.z, 3.0);
+    }
+
+    #[test]
+    fn invalid_snapshot_leaves_previous_list_intact() {
+        let mut lights = Vec::new();
+        apply(&mut lights, &[state()], CoordinateSystem::Unity, 0);
+        for field in 0..9 {
+            let mut invalid = state();
+            match field {
+                0 => invalid.ty = 5,
+                1 => invalid.cast_shadows = 2,
+                2 => invalid.cookie = 0,
+                3 => invalid.range = -1.0,
+                4 => invalid.position.x = f32::NAN,
+                5 => invalid.spot_inner_percent = 101.0,
+                6 => invalid.spot_outer = 181.0,
+                7 => invalid.area_size.y = f32::INFINITY,
+                _ => invalid.shadow_radius_or_angle = f32::NAN,
+            }
+            assert!(!apply(&mut lights, &[state(), invalid], CoordinateSystem::Unity, 0));
+            assert_eq!(lights.len(), 1);
+            assert_eq!(lights[0].position.z, -3.0);
+        }
+    }
+
+    #[test]
+    fn zero_intensity_and_shape_changes_survive_replacement() {
+        let mut lights = Vec::new();
+        let mut updated = state();
+        updated.color = Vector3::ZERO;
+        updated.spot_outer = 65.0;
+        updated.spot_inner_percent = 50.0;
+        updated.area_size = Vector2::new(5.0, 6.0);
+        apply(&mut lights, &[updated], CoordinateSystem::Unity, 0);
+        assert_eq!(lights[0].color.x, 0.0);
+        assert_eq!(lights[0].spot_outer, 65.0);
+        assert_eq!(lights[0].spot_inner_percent, 50.0);
+        assert_eq!(lights[0].area_or_cookie_size.y, 6.0);
+    }
+
+    #[test]
+    fn indirect_changes_coalesce_independently_of_light_snapshots() {
+        let mut updates = Updates::default();
+        assert!(!updates.publish_indirect(1.0));
+        updates.reset(true);
+        assert!(updates.publish(&[state()]));
+        assert!(updates.publish_indirect(2.0));
+        assert!(updates.publish_indirect(0.0));
+        assert!(updates.publish(&[]));
+        assert_eq!(updates.pending_indirect.take(), Some(0.0));
+        assert!(updates.pending.as_ref().unwrap().is_empty());
+        assert!(updates.publish_indirect(3.0));
+        for invalid in [f32::NAN, f32::INFINITY, -1.0] {
+            assert!(!updates.publish_indirect(invalid));
+        }
+        assert_eq!(updates.pending_indirect, Some(3.0));
+        updates.reset(false);
+        updates.reset(true);
+        assert!(updates.pending_indirect.is_none());
+    }
+
+    #[test]
+    fn ffi_and_shader_layouts_match() {
+        assert_eq!(std::mem::size_of::<PreviewLightState>(), 88);
+        assert_eq!(std::mem::offset_of!(PreviewLightState, ty), 68);
+        assert_eq!(std::mem::offset_of!(PreviewLightState, cookie), 80);
+        assert_eq!(std::mem::offset_of!(PreviewLightState, shadow_radius_or_angle), 84);
+        assert_eq!(std::mem::size_of::<crate::shader::PreviewPushConstants>(), 40);
+        assert_eq!(std::mem::offset_of!(crate::shader::PreviewPushConstants, lights_address), 24);
+        assert_eq!(std::mem::offset_of!(crate::shader::PreviewPushConstants, indirect_intensity), 32);
+    }
+}
+
